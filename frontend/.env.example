# Copy to frontend/.env (git-ignored) and restart `npm run dev`. Vite only exposes variables that start with VITE_.

VITE_API_URL=http://localhost:3001/api

# Google sign-in (Firebase). Firebase console > Project settings > General > Your apps > Web app > SDK setup and configuration.
# These values identify the project; they are not secrets. Leave them empty and the Google button is shown disabled.
# VITE_FIREBASE_PROJECT_ID must equal FIREBASE_PROJECT_ID in backend/.env.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# DEVELOPMENT ONLY: use the Firebase Auth emulator instead of Google (production builds ignore this).
# VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
