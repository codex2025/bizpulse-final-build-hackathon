# Copy to backend/.env (git-ignored) and adjust. For a local run only JWT_SECRET is worth setting: without it a random
# key is generated on every start, which is safe but signs everybody out whenever the server restarts.

# Signs the session tokens. REQUIRED in production: the server refuses to start without a strong, non-placeholder value.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Google sign-in through Firebase: the Firebase PROJECT ID (Firebase console > Project settings > General).
# It must be the same project as VITE_FIREBASE_PROJECT_ID in frontend/.env. Leave empty to turn Google sign-in off
# (email + password sign-in keeps working). Nothing else is needed on the server: ID tokens are checked against
# Google's public keys, so there is no service-account key to store.
FIREBASE_PROJECT_ID=

# SQLite file for accounts, decision runs, approvals, policy and each user's recoverable workspace state.
# Default ./finsight.db. Point it at a persistent volume in production.
# DATABASE_URL=postgres://user:password@host/db   # shared Postgres; required on serverless hosts (overrides DATABASE_PATH)
DATABASE_PATH=./finsight.db

PORT=3001
# The ai-service: a full URL, or just host:port (a missing scheme is read as http://).
AI_SERVICE_URL=http://localhost:8000
# Shared secret sent to the ai-service as X-Internal-Token (must match the ai-service value; optional locally)
AI_SERVICE_TOKEN=

# LOCAL DEVELOPMENT ONLY: check Google sign-in tokens against the Firebase Auth emulator instead of Google.
# The server refuses to start with this set when NODE_ENV=production (the emulator accepts unsigned tokens).
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
