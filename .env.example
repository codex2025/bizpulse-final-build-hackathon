# ==========================================
# Bizpulse v2 - Environment Configuration
# ==========================================

# --- AI Service (FastAPI / RAG) ---
OPENAI_API_KEY=your_openai_api_key_here
MODEL_NAME=gpt-4o
CHROMA_PERSIST_DIR=./chroma_data
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Backend Gateway (NestJS) ---
PORT=3001
# Signs session tokens. REQUIRED in production (the server refuses to start without a strong, non-placeholder value); in
# development a random key is used when this is empty. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Full URL, or just host:port (a missing scheme is read as http://) -- for example Render's private hostport.
AI_SERVICE_URL=http://localhost:8000
# SQLite file for runs, approvals, policy and each user's workspace state. Point it at a persistent volume in production.
DATABASE_PATH=./finsight.db

# --- Frontend (React / Vite) ---
VITE_API_URL=http://localhost:3001/api

# --- Google sign-in through Firebase (see README.md, "Google sign-in") ---
# Backend: the Firebase PROJECT ID only (no secret is needed: ID tokens are verified against Google's public keys).
FIREBASE_PROJECT_ID=
# Frontend: the Firebase web app config. Public identifiers, not secrets. Empty = the Google button is disabled.
# VITE_FIREBASE_PROJECT_ID must equal FIREBASE_PROJECT_ID.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- DecisionForge hardening (optional locally, recommended when the ai-service is reachable publicly) ---
# If set on BOTH the gateway and the ai-service, the ai-service rejects requests without this shared secret.
AI_SERVICE_TOKEN=
# Optional LLM query planner (falls back to the deterministic rules planner when unset/unavailable).
# Uses OPENAI_API_KEY above; the model only ever sees the question text, never business data.
DECISION_PLANNER_MODEL=gpt-4o-mini
