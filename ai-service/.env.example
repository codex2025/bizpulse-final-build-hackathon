OPENAI_API_KEY=your_openai_api_key_here
DATABASE_URL=postgresql://postgres:password@localhost:5432/finsight
MODEL_NAME=gpt-4o
MAX_TOKENS=2000

# Shared secret required in X-Internal-Token on DecisionForge routes (must match the gateway; optional locally)
AI_SERVICE_TOKEN=
# Optional LLM query planner: needs OPENAI_API_KEY. The model sees only the question, never business data.
DECISION_PLANNER_MODEL=gpt-4o-mini
